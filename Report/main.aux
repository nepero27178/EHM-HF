\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces Depiction of the sectors composing the MBZ (Fig.~\ref {subfig:MBZ-sectors}) and the NBZ (Fig.~\ref {subfig:NBZ-sectors}), based on the divisions shown in the top-left panel of Fig.~\ref {fig:normal-nematic-bands}. The full green zone composes $\mathcal  {A}$, the region where both the $s^*$-wave and $d$-wave structure factors are positive defined; its MBZ complementary white counterpart in the left panel gives $\mathcal  {B}$, for which the $s^*$-wave structure factors is positive-definite while the $d$-wave is negative. Similarly the NBZ complementary white counterpart in the right panel gives $\mathcal  {C}$, for which signs are exchanged. The black dots, at the contours intersection, are band nodes.}}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:BZ-sectors}{{1.4}{11}{Depiction of the sectors composing the MBZ (Fig.~\ref {subfig:MBZ-sectors}) and the NBZ (Fig.~\ref {subfig:NBZ-sectors}), based on the divisions shown in the top-left panel of Fig.~\ref {fig:normal-nematic-bands}. The full green zone composes $\mathcal {A}$, the region where both the $s^*$-wave and $d$-wave structure factors are positive defined; its MBZ complementary white counterpart in the left panel gives $\mathcal {B}$, for which the $s^*$-wave structure factors is positive-definite while the $d$-wave is negative. Similarly the NBZ complementary white counterpart in the right panel gives $\mathcal {C}$, for which signs are exchanged. The black dots, at the contours intersection, are band nodes}{figure.caption.10}{}}
