      \field{journaltitle}{Journal of the Physical Society of Japan}
      \field{month}{3}
      \field{number}{3}
      \field{title}{Soliton {Lattice} {Modulation} of {Incommensurate} {Spin} {Density} {Wave} in {Two} {Dimensional} {Hubbard} {Model} -{A} {Mean} {Field} {Study}-}
