\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces Sketch of the Hubbard DoS as we vary the ratio $U/t$. For $U=0$ (gray plot on the left) we have a free electronic band. As we increase $U$, two peaks appear while the central coherent peak shrinks. At $U \gg t$ (blue plot on the right), the DoS is separated in upper and lower Hubbard bands (UHB, LHB). $E_\mathrm  {F}$ is the Fermi energy.}}{3}{figure.caption.5}\protected@file@percent }
\newlabel{fig:hubbard-bands}{{1.3}{3}{Sketch of the Hubbard DoS as we vary the ratio $U/t$. For $U=0$ (gray plot on the left) we have a free electronic band. As we increase $U$, two peaks appear while the central coherent peak shrinks. At $U \gg t$ (blue plot on the right), the DoS is separated in upper and lower Hubbard bands (UHB, LHB). $E_\mathrm {F}$ is the Fermi energy}{figure.caption.5}{}}
\newlabel{eq:hubbard-2-sites}{{1.2}{3}{The Mott insulating state in the Hubbard model}{equation.1.2}{}}
